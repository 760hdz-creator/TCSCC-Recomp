+// Xenos half float (vupkd3d128 FLOAT16): no inf/NaN, exponent 31 is a normal value; denormals flush to 0.
+inline float ppcXenosHalfToFloat(uint16_t value)
+{
+    uint32_t mantissa = value & 0x3FFu, exponent = (value >> 10u) & 0x1Fu;
+    if (!exponent)
+    {
+        mantissa = 0;
+        exponent = uint32_t(-112);
+    }
+    uint32_t bits = (uint32_t(value & 0x8000u) << 16u) | ((exponent + 112u) << 23u) | (mantissa << 13u);
+    float f;
+    memcpy(&f, &bits, 4);
+    return f;
+}
